# ==============================================================================
# Caderno Editorial — Variáveis de Ambiente (Supabase)
# ==============================================================================
# 1. Copie este arquivo para `.env.local` na raiz do projeto.
# 2. Acesse o painel do seu projeto no Supabase (https://supabase.com/dashboard).
# 3. Vá em: Project Settings > API (ou Data API / API Keys).
# 4. Copie a "Project URL" e a chave pública "anon / public" (ou publishable key).
# 5. Nunca faça commit do `.env.local` (ele já está listado no `.gitignore`).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
